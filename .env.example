# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com
# Project Settings → API → Project URL and anon (public) API Key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
# Application name and version
VITE_APP_NAME=Scan2Save
VITE_APP_VERSION=1.0.0

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# Feature Flags
# Enable/disable YOLOv8 model inference
VITE_ENABLE_YOLO_MODEL=true

# Enable/disable scan history from database
VITE_ENABLE_SCAN_HISTORY=true

# Enable/disable user profile features
VITE_ENABLE_USER_PROFILES=true

# Environment
# Options: development, production, staging
VITE_NODE_ENV=development
